# ================================================================
#  FASTER LOANS UGANDA — ENVIRONMENT CONFIGURATION
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ================================================================

# ── Server ───────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000
FRONTEND_URL=http://localhost:3000   # used for CORS & email links
TZ=Africa/Kampala             # Uganda EAT (UTC+3) — process-level timezone

# ── Database (MySQL) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=faster_loans
DB_SSL=false                  # set true in production with RDS/Cloud SQL

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64+_char_random_secret
JWT_EXPIRES_IN=15m            # access token lifetime
JWT_REFRESH_SECRET=another_64+_char_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (AES-256 for PAN/account numbers) ─────────────────
ENCRYPTION_KEY=32_byte_hex_key_here_64_chars_total_00000000000000000000
ENCRYPTION_IV=16_byte_hex_iv_here_32chars000000

# ── Africa's Talking (SMS — Uganda) ──────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_at_username    # use 'sandbox' for testing
AT_SENDER_ID=FasterLoans        # short-code or alphanumeric

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Faster Loans Uganda <noreply@fasterloans.co.ug>"

# ── Payment Provider — Pesapal (Uganda) ──────────────────────────
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret
PESAPAL_ENV=sandbox             # sandbox | live
PESAPAL_IPN_URL=https://yourdomain.co.ug/api/payments/webhook/pesapal

# ── Payment Provider — Flutterwave (fallback) ────────────────────
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxx
FLW_ENV=sandbox                 # sandbox | live
FLW_WEBHOOK_HASH=your_flutterwave_webhook_hash

# ── Company Info (used in emails/SMS) ────────────────────────────
COMPANY_NAME=Faster Loans Uganda Limited
COMPANY_PHONE=+256700123456
COMPANY_EMAIL=info@fasterloans.co.ug
COMPANY_ADDRESS=Plot 42, Kampala Road, Kampala

# ── Loan Settings ────────────────────────────────────────────────
DEDUCTION_DAY=28          # day of month for auto-debit
REMINDER_DAY=25           # day of month for SMS reminder

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 min
RATE_LIMIT_MAX=100            # requests per window per IP
AUTH_RATE_LIMIT_MAX=10        # stricter for login/register

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Compliance ────────────────────────────────────────────────────
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
MANDATE_VERSION=1.0
